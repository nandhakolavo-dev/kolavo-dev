  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.90.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
